{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Monitor Duo",
  "version": "0.85.0-rust.1",
  "identifier": "com.mrxiuer.tokenmonitor.duo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Token Monitor Duo",
        "width": 340,
        "height": 650,
        "minWidth": 280,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "shortDescription": "Codex usage by member and Pro quota cycle",
    "copyright": "Based on Javis603/token-monitor (MIT)"
  }
}
